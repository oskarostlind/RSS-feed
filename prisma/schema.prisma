// Omvärldsbevakare — datamodell (MVP)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum NewsItemStatus {
  PENDING
  CONFIRMED
  REJECTED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  companies     Company[]

  /**
   * Satt när användaren avregistrerat sig från morgonmejlet. Nullbar utan
   * default, så att befintliga och nya användare prenumererar som förval — att
   * av misstag avregistrera någon är ett tystare fel än motsatsen.
   *
   * En tidsstämpel och inte en boolean: vid en klagan om "jag får fortfarande
   * mejl" är frågan alltid *när* det stängdes av, inte om.
   */
  morningEmailOptOutAt DateTime?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Company {
  id                String             @id @default(cuid())
  name              String
  userId            String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  /// När bolaget senast söktes igenom. Morgonkörningen tar äldst först, så att
  /// inget bolag svälter när tidsbudgeten inte räcker till hela portföljen.
  /// Null = aldrig sökt, och prioriteras därför högst.
  lastCheckedAt     DateTime?
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  newsItems         NewsItem[]
  jobAds            JobAd[]
  discoveredSources DiscoveredSource[]

  @@unique([userId, name])
  @@index([userId])
  @@index([lastCheckedAt])
}

model NewsItem {
  id          String         @id @default(cuid())
  companyId   String
  title       String
  snippet     String?
  // Unik per bolag, inte globalt. Två användare som bevakar samma bolag — eller
  // två bolag som nämns i samma artikel — ska båda få träffen. Med global
  // unikhet vann den som råkade sparas först och den andra tystades av
  // dedupliceringen utan spår.
  url         String
  publishedAt DateTime?
  status      NewsItemStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, url])
  @@index([companyId])
  @@index([status])
}

/**
 * Jobbannons från Arbetsförmedlingens Platsbanken.
 *
 * Egen modell och inte en `NewsItem`, därför att fälten faktiskt används: ort
 * och yrke är det som gör en annons till en expansionssignal, och de går inte
 * att utläsa ur en rubriksträng.
 */
model JobAd {
  id                 String    @id @default(cuid())
  companyId          String
  /// JobTechs annons-id. Unikhetsnyckel i stället för URL:en, som är härledd.
  externalId         String
  headline           String
  employerName       String
  workplaceName      String?
  organizationNumber String?
  occupation         String?
  municipality       String?
  region             String?
  url                String
  publishedAt        DateTime?
  deadline           DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Unikhet per bolag, av samma skäl som på NewsItem: två bevakningar av
  // samma arbetsgivare ska båda få träffen.
  @@unique([companyId, externalId])
  @@index([companyId])
  @@index([publishedAt])
}

model DiscoveredSource {
  id         String   @id @default(cuid())
  companyId  String
  domain     String
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, domain])
  @@index([companyId])
}

/// Ett begärt inloggningsmejl. Finns bara för att kunna räkna dem.
///
/// Utan tak kan vem som helst utlösa obegränsat många magiska länkar till
/// vilken adress som helst — både ett sätt att spamma en tredje part som
/// aldrig bett om något, och ett sätt att bränna mejlkvoten så att riktiga
/// användare inte kan logga in.
///
/// Egen tabell i stället för att räkna `VerificationToken`: de raderas när de
/// förbrukas, så de som faktiskt användes hade räknats bort — och det är
/// precis de legitima försöken.
model LoginAttempt {
  id         String   @id @default(cuid())
  /// Normaliserad mejladress, gemener och trimmad.
  identifier String
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@index([createdAt])
}
